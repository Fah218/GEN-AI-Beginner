{
  "manifest_version": 3,
  "name": "LinkLens AI",
  "version": "1.0",
  "description": "An AI copilot for LinkedIn.",
  "action": {
    "default_popup": "popup.html"
  },
 "permissions": [
  "activeTab",
  "storage"
],
"host_permissions": [
  "https://linklens-ai-backend.onrender.com/*"
],
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
